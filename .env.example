# Copy this file to .env (git-ignored) and fill in the keys. Never commit or share the real values.
TYPESAFE_API_KEY=        # Jev (structure decisions) — https://typesafe.ai
# Copywriting. Default: COPY_PROVIDER=cli → uses the Claude Code login on this machine (run `claude` and /login once). No API credits needed.
# COPY_PROVIDER=api        # use the Anthropic API instead (needs credits)
ANTHROPIC_API_KEY=       # only for COPY_PROVIDER=api — https://console.anthropic.com → API Keys
# COPY_MODEL=sonnet       # optional: model for copy (cli: sonnet | opus | haiku; api: full model id)
